# Local development (SQLite)
DATABASE_URL=file:./cms.db

# Production database. If set, Payload automatically switches to Postgres.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required in every environment. Use a long random value in production.
PAYLOAD_SECRET=CHANGE_ME

# CMS origin used for preview URLs and Payload serverURL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Public BAEV site origin. Used for CORS/CSRF allow-list.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional production media storage. Created by Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Optional: only used by npm run seed to create a local/admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

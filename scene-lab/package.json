{
  "name": "baev-scene-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4186 --strictPort",
    "build": "vite build && node scripts/budget.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4187 --strictPort",
    "test": "node --test scripts/*.test.mjs",
    "model:build": "node scripts/blender.mjs",
    "model:optimize": "node scripts/optimize.mjs",
    "test:browser": "node scripts/story-browser.mjs",
    "cast:build": "node scripts/prepare-cast.mjs && node scripts/prepare-seating.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "tweakpane": "4.0.5",
    "vite": "8.3.4"
  }
}
